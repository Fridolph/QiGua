{
  "manifest_version": 3,
  "name": "起卦 · QiGua",
  "version": "0.1.0",
  "description": "三种起卦方式即时查六十四卦——时间起卦、硬币起卦、名字起卦，获取卦象与体用生克。",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "起卦 · QiGua",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel"
  ]
}
